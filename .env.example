BOT_TOKEN=123456:replace-me
DATABASE_URL=postgresql://moviebot:moviebot@postgres:5432/moviebot
REDIS_URL=redis://redis:6379/0
ADMIN_IDS=123456789
ENVIRONMENT=production
# Set for horizontally scalable webhook deployments. Leave empty for one polling process.
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace-with-a-long-random-secret
HOST=0.0.0.0
PORT=8080
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
SUBSCRIPTION_CACHE_TTL=600
RATE_LIMIT_PER_SECOND=2
BROADCAST_CONCURRENCY=20
BROADCAST_RATE_PER_SECOND=25
RUN_BROADCAST_WORKER=false
